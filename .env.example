# 서버 환경 변수 예시. 실제 값은 `.env`(또는 `.env.txt`)에 넣는다. 둘 다 git에서 무시된다.
# 서버는 `.env`를 우선 읽고, 없으면 `.env.txt`를 읽는다.

PORT=8787

# claude | mock  (키가 없으면 mock)
AGENT_MODE=mock

# Our Room 자동 반응·자동 대리 (기본 on). off면 질문·지정·부재 구성원 언급일 때만 Agent가 깨는 이전 규칙
# AGENT_AUTO_REPLY=on

# A2A: Our Room에서 Agent끼리 묻고 답하기(ask_agents). off면 끄고 이전 동작과 같다 (기본 on)
# AGENT_A2A=on
# 에피소드(사람 발언 1건)당 ask 라운드 (기본 1) / ask당 수신 Agent 수 (기본 3) / 에피소드당 a2a 턴 하드캡 (기본 6)
# A2A_MAX_ROUNDS=1
# A2A_FANOUT_MAX=3
# A2A_MAX_TURNS_PER_EPISODE=6

# Claude API (프록시를 쓰면 BASE_URL 지정)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_AGENT=claude-sonnet-5
ANTHROPIC_MODEL_LIGHT=claude-sonnet-4-6

# 보드 도구(여행 계획·메모판) 커버 이미지: APIFrame. 키가 있으면 켜지고, 키가 없으면 기본 일러스트로 동작한다.
# 끄려면 BOARD_TOOL_COVERS=off
APIFRAME_API_KEY=
# BOARD_TOOL_COVERS=on
